# Copy to .env next to docker-compose.yml, on the server. Not versioned.

# Generate it on the server, do not invent one by hand:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" > .env
POSTGRES_PASSWORD=

# The address the BROWSER uses, port included. Label Studio builds its links
# with this and validates the origin of every form against it: if it does not
# match what is in the address bar, the session is rejected with
# "authentication credentials were not provided".
#
#   over an ssh tunnel   http://localhost:8081
#   with a domain        https://labelstudio.suyana.io
LABEL_STUDIO_HOST=http://localhost:8081
